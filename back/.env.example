# Server Configuration
PORT=5000
NODE_ENV=development

# Debug Mode (set to 'true' to enable console logs in production)
DEBUG=false

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=ritto_user
DB_PASSWORD=ritto_password
DB_NAME=ritto_db

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Session Configuration
SESSION_SECRET=your_session_secret_key_here_change_in_production

# Supabase Configuration (optional)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe Configuration
STRIPE_SECRET_KEY=

# Admin Configuration
ADMIN_EMAIL=admin@ritto.com

# Saby Service Configuration (Go microservice)
SABY_SERVICE_URL=http://saby-service:8080

# SBIS Configuration
SBIS_POINT_ID=1
SBIS_PRICE_LIST_ID=1

# Client Configuration
CLIENT_URL=http://localhost:5173

# VK Mini App Configuration
VK_APP_SECRET=your_vk_app_secret_here
VK_MINI_APP_URL=http://localhost:3000
