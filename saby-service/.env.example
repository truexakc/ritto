# ======================
# SABY SERVICE CONFIGURATION
# ======================

# SABY API Configuration
# The base URL for the SABY (SBIS) Retail API
SABY_API_URL=https://api.sbis.ru

# SABY API Key for authentication
# Replace with your actual API key from SABY
SABY_API_KEY=your_saby_api_key_here

# SABY Stub Mode
# Enable stub mode to prevent real API calls during testing/development
# When enabled, orders will be logged but not sent to SABY API
# Mock responses with "STUB-{timestamp}" order IDs will be returned
# Set to "true" or "1" to enable, any other value disables
# Default: false (disabled)
SABY_STUB_MODE=false

# Service Configuration
# Port on which the Go microservice will listen
PORT=8080

# Environment (development, staging, production)
ENVIRONMENT=development

# ======================
# CATALOG IMPORT CONFIGURATION
# ======================

# SBIS API Access Token
# Authentication token for SBIS Retail API nomenclature endpoints
# Required for catalog import functionality
SBIS_ACCESS_TOKEN=your_sbis_access_token_here

# SBIS Point ID
# The retail point identifier for nomenclature requests
# Required - must be a valid integer
SBIS_POINT_ID=12345

# SBIS Price List ID
# The price list identifier for nomenclature requests
# Required - must be a valid integer
SBIS_PRICE_LIST_ID=67890

# Import Page Size
# Number of items to fetch per API request page
# Default: 100, Valid range: 1-1000
IMPORT_PAGE_SIZE=100

# Import Schedule
# Cron expression for scheduled catalog imports
# Default: "0 3 * * *" (daily at 3:00 AM)
# Format: minute hour day month weekday
IMPORT_SCHEDULE=0 3 * * *

# Import Timeout
# Maximum duration for a single import operation
# Default: 30m (30 minutes)
# Format: duration string (e.g., "30m", "1h", "90s")
IMPORT_TIMEOUT=30m

# Max Pagination Pages
# Maximum number of pages to fetch from SBIS API
# Prevents infinite loops in case of API issues
# Default: 1000
MAX_PAGINATION_PAGES=1000

# Database Connection String
# PostgreSQL connection string for catalog persistence
# Format: postgres://user:password@host:port/database?sslmode=disable
# Required for catalog import functionality
DB_CONNECTION_STRING=postgres://user:password@localhost:5432/ritto_db?sslmode=disable

# Image Storage Path
# Local file system path for storing downloaded product images
# Default: "./images"
# The directory will be created if it doesn't exist
IMAGE_STORAGE_PATH=./images

# Enable Scheduler
# Enable or disable automatic scheduled imports
# Set to "false" in development/test environments to prevent automatic imports
# Default: true
ENABLE_SCHEDULER=true
