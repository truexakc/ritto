# ======================
# DATABASE CONFIGURATION
# ======================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=ritto_db
DB_HOST=postgres
DB_PORT=5432

# ======================
# BACKEND CONFIGURATION
# ======================
PORT=5001
NODE_ENV=production

# Debug Mode (set to 'true' to enable console logs in production)
DEBUG=false

# JWT Secrets (generate strong random strings)
JWT_SECRET=your_jwt_secret_key_change_this
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_this

# Session Secret
SESSION_SECRET=your_session_secret_key_change_this

# ======================
# STRIPE CONFIGURATION
# ======================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ======================
# CLIENT CONFIGURATION
# ======================
CLIENT_URL=http://localhost:5173

# ======================
# SABY SERVICE CONFIGURATION
# ======================
# SABY API credentials (used by Go microservice)
SABY_API_URL=https://api.sbis.ru
SABY_API_KEY=your_saby_api_key_here

# SABY Go Microservice URL (used by Node.js backend)
# In Docker: http://saby-service:8080
# In local development: http://localhost:8080
SABY_SERVICE_URL=http://saby-service:8080

# ======================
# OPTIONAL SERVICES
# ======================
# Supabase (if using)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# ======================
# DEVELOPMENT ONLY
# ======================
# Uncomment for local development
# DB_HOST=localhost
# CLIENT_URL=http://localhost:5173
