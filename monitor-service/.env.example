TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Интервалы проверки (в секундах)
CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=10

# Сервисы для мониторинга (через запятую)
MONITORED_SERVICES=backend,frontend,saby-service

# Health check endpoints (формат: service_name=http://host:port/health)
HEALTH_ENDPOINTS=backend=http://backend:3000/health,saby-service=http://saby-service:8080/health

# Алерты
ALERT_ON_CONTAINER_RESTART=true
ALERT_ON_HEALTH_CHECK_FAIL=true
ALERT_ON_HIGH_CPU=true
CPU_THRESHOLD=80
MEMORY_THRESHOLD=80
